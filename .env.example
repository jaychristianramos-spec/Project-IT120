# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file. This example contains placeholders only.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# From the Twilio Console dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Use ONE of the two sender options below (leave the other blank)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_MESSAGING_SERVICE_SID=

# Used to convert local numbers like 0917... into +63917...
DEFAULT_COUNTRY_CODE=+63
